{
  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/managementGroupDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  // MARK: Parameters
  "parameters": {
    "enterpriseScaleCompanyPrefix": {
      "type": "string",
      "metadata": {
        "description": "Provide a prefix (unique at tenant-scope) for the Management Group hierarchy and other resources created as part of Enterprise-scale."
      }
    },
    "telemetryOptOut": {
      "type": "string",
      "defaultValue": "No",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "displayName": "Telemetry Opt Out",
        "description": "The customer usage identifier used for telemetry purposes. The default value of False enables telemetry. The value of True disables telemetry."
      }
    },
    "managementManagementGroup": {
      "type": "string",
      "metadata": {
        "description": "Provide the name of the Management Group that will be used to host the management resources."
      }
    },
    "landingZoneManagementGroup": {
      "type": "string",
      "metadata": {
        "description": "Provide the name of the Management Group that will be used to host the landing zone resources."
      }
    },
    "enableAMBASql": {
      "type": "string",
      "defaultValue": "Yes",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Assign SQL initiative"
      }
    },
    "enableAMBAOssDB": {
      "type": "string",
      "defaultValue": "Yes",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Assign OSS DB initiative"
      }
    },
    "enableAMBANotificationAssets": {
      "type": "string",
      "defaultValue": "Yes",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Assign Notification assets initiative"
      }
    },
    "DataMonitorResourceGroupLocation": {
      "type": "string",
      "defaultValue": "northeurope",
      "metadata": {
        "description": "Provide the location of the resource group for Azure Monitor Baseline Alerts."
      }
    },
    "DataMonitorResourceGroupTags": {
      "type": "object",
      "defaultValue": {
        "_deployed_by_amba_data": true
      },
      "metadata": {
        "description": "Provide the tags for the resource group for Azure Monitor Baseline Alerts."
      }
    },
    "DataMonitorDisableTagName": {
      "type": "String",
      "metadata": {
        "displayName": "Effect",
        "description": "Tag name to disable monitoring on resource. Set to true if monitoring should be disabled"
      },
      "defaultValue": "MonitorDisable"
    },
    "DataMonitorDisableTagValues": {
      "type": "Array",
      "metadata": {
        "displayName": "Data Monitoring disabled tag values(s)",
        "description": "Tag value(s) used to disable monitoring at the resource level. Set to true if monitoring should be disabled."
      },
      "defaultValue": [
        "true",
        "Test",
        "Dev",
        "Sandbox"
      ]
    },
    "DataMonitorActionGroupEmail": {
      "type": "Array",
      "defaultValue": [],
      "metadata": {
        "description": "Provide the email address(es) for the action group used for monitoring."
      }
    },
    "DataMonitorLogicappResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Provide the resource id of the logic app used for monitoring."
      }
    },
    "DataMonitorLogicappCallbackUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Provide the callback url of the logic app used for monitoring."
      }
    },
    "DataMonitorArmRoleId": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Provide the role id used for monitoring."
      }
    },
    "DataMonitorEventHubResourceId": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Provide the resource id of the event hub used for monitoring."
      }
    },
    "DataMonitorWebhookServiceUri": {
      "type": "Array",
      "defaultValue": [],
      "metadata": {
        "description": "Provide the service uri(s) of the webhook used for monitoring."
      }
    },
    "DataMonitorFunctionResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Provide the resource id of the function used for monitoring."
      }
    },
    "DataMonitorFunctionTriggerUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Provide the trigger url of the function used for monitoring."
      }
    },
    "DataMonitorBYOActionGroup": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Provide the action group used for monitoring."
      }
    },
    "DataMonitorBYOAlertProcessingRule": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Provide the alert processing rule used for monitoring."
      }
    },
    "DataMonitorAlertSeverity": {
      "type": "array",
      "defaultValue": [
        "Sev0",
        "Sev1",
        "Sev2",
        "Sev3",
        "Sev4"
      ],
      "metadata": {
        "description": "Alert Severities for alert processing rule to action."
      }
    },
    "DataMonitorNotificationAssetSuffix": {
      "type": "string",
      "defaultValue": "-001",
      "metadata": {
        "description": "Suffix for the notification assets."
      }
    },
    "currentDateTimeUtcNow": {
      "type": "string",
      "defaultValue": "[utcNow()]",
      "metadata": {
        "description": "The current date and time using the utcNow function. Used for deployment name uniqueness"
      }
    },
    "policyAssignmentExclusionList": {
      "type": "object",
      "defaultValue": {
        "notificationAssetsAssignmentExcludedResources": {
          "value": []
        },
        "SqlAssignmentExcludedResources": {
          "value": []
        },
        "OssDBAssignmentExcludedResources": {
          "value": []
        }
      }
    },
    "policyAssignmentParametersSql": {
      "type": "object",
      "defaultValue": {}
    },
    "policyAssignmentParametersOssDB": {
      "type": "object",
      "defaultValue": {}
    },
    "deployAmbaDataPortalAccelerator": {
      "type": "string",
      "defaultValue": "No",
      "allowedValues": [
        "Yes",
        "No"
      ],
      "metadata": {
        "description": "Microsoft can identify the deployments of the Azure Resource Manager templates with the deployed Azure resources. Microsoft collects this information to provide the best experiences with their products and to operate their business. The telemetry is collected through customer usage attribution. The data is collected and governed by Microsoft's privacy policies, located at the trust center. Visit this link to find out more."
      }
    }
  },
  // MARK: Variables
  "variables": {
    "policyAssignmentParametersCommon": {
      "DataMonitorResourceGroupName": {
        "value": "[parameters('DataMonitorResourceGroupName')]"
      },
      "DataMonitorResourceGroupTags": {
        "value": "[parameters('DataMonitorResourceGroupTags')]"
      },
      "DataMonitorResourceGroupLocation": {
        "value": "[parameters('DataMonitorResourceGroupLocation')]"
      },
      "DataMonitorDisableTagName": {
        "value": "[parameters('DataMonitorDisableTagName')]"
      },
      "DataMonitorDisableTagValues": {
        "value": "[parameters('DataMonitorDisableTagValues')]"
      }
    },
    "policyAssignmentParametersMonitorDisable": {
      "DataMonitorDisableTagName": {
        "value": "[parameters('DataMonitorDisableTagName')]"
      },
      "DataMonitorDisableTagValues": {
        "value": "[parameters('DataMonitorDisableTagValues')]"
      }
    },
    "notificationAssetParameters": {
      "DataMonitorActionGroupEmail": {
        "value": "[parameters('DataMonitorActionGroupEmail')]"
      },
      "DataLogicappResourceId": {
        "value": "[parameters('DataLogicappResourceId')]"
      },
      "DataLogicappCallbackUrl": {
        "value": "[parameters('DataLogicappCallbackUrl')]"
      },
      "DataArmRoleId": {
        "value": "[parameters('DataArmRoleId')]"
      },
      "DataEventHubResourceId": {
        "value": "[parameters('DataEventHubResourceId')]"
      },
      "DataWebhookServiceUri": {
        "value": "[parameters('DataWebhookServiceUri')]"
      },
      "DataFunctionResourceId": {
        "value": "[parameters('DataFunctionResourceId')]"
      },
      "DataFunctionTriggerUrl": {
        "value": "[parameters('DataFunctionTriggerUrl')]"
      },
      "BYOActionGroup": {
        "value": "[parameters('BYOActionGroup')]"
      },
      "BYOAlertProcessingRule": {
        "value": "[parameters('BYOAlertProcessingRule')]"
      }
    },
    "notificationAssetSeverityParameters": {
      "DataAlertSeverity": {
        "value": "[parameters('DataAlertSeverity')]"
      },
      "DataNotificationAssetSuffix": {
        "value": "[parameters('DataNotificationAssetSuffix')]"
      }
    },
    // Declaring the policy assignment parameters that will be used for all policy assignments
    "policyAssignmentParametersNotificationAssets": "[union(variables('policyAssignmentParametersCommon'), variables('notificationAssetParameters'), variables('notificationAssetSeverityParameters'))]",
    "policyAssignmentParametersSql": "[union(variables('policyAssignmentParametersCommon'), parameters('policyAssignmentParametersSql'))]",
    "policyAssignmentParametersOssDB": "[union(variables('policyAssignmentParametersCommon'), parameters('policyAssignmentParametersOssDB'))]",
    // Declaring all required deployment uri's used for deployments of composite ARM templates for ESLZ
    "deploymentUris": {
      "policyDefinitionsNotificationAssets": "[uri(deployment().properties.templateLink.uri, 'policyDefinitions/policies-NotificationAssets.json')]",
      "policyDefinitionsSql": "[uri(deployment().properties.templateLink.uri, 'policyDefinitions/policies-Sql.json')]",
      "policyDefinitionsOssDB": "[uri(deployment().properties.templateLink.uri, 'policyDefinitions/policies-OssDB.json')]",
      "policySetDefinitions": "[uri(deployment().properties.templateLink.uri, 'policyDefinitions/policySets.json')]",
      "DataMonitorNotificationAssetsInitiative": "[uri(deployment().properties.templateLink.uri, 'policyAssignments/DINE-NotificationAssetsAssignment.json')]",
      "DataMonitorSqlInitiative": "[uri(deployment().properties.templateLink.uri, 'policyAssignments/DINE-SqlAssignment.json')]",
      "DataMonitorOssDBInitiative": "[uri(deployment().properties.templateLink.uri, 'policyAssignments/DINE-OssDBAssignment.json')]"
    },
    // Declaring PIDs
    "cuaid": "49be9f73-016c-4160-8725-7a31d447931c",
    "cuaidNotificationAssets": "4c6cd4c6-e0ab-4c09-8f29-55ba50ba7a98",
    "cuaidSql": "11c4d419-e961-4f64-b832-688a4d5b377e",
    "cuaidOssDB": "79c175ee-6e8f-40ec-8078-21af43a368e2",
    "cuaidAmbaDataAccelerator": "406fb605-553f-4ff1-8798-1bc95704d7b4",
    // Declaring deterministic deployment names
    "deploymentSuffix": "[concat('-', deployment().location, '-', guid(parameters('enterpriseScaleCompanyPrefix'), parameters('currentDateTimeUtcNow')))]",
    "deploymentNames": {
      "DataMonitorResourceGroupDeploymentName": "[take(concat('amba-rg', variables('deploymentSuffix')), 64)]",
      "policyDefinitionsNotificationAssetsDeploymentName": "[take(concat('amba-Policy-NotificationAssets', variables('deploymentSuffix')), 64)]",
      "policyDefinitionsSqlDeploymentName": "[take(concat('amba-Policy-Sql', variables('deploymentSuffix')), 64)]",
      "policyDefinitionsOssDBDeploymentName": "[take(concat('amba-Policy-OssDB', variables('deploymentSuffix')), 64)]",
      "policySetDefinitionsDeploymentName": "[take(concat('amba-PolicySet', variables('deploymentSuffix')), 64)]",
      "DataMonitorNotificationAssetsDeploymentName": "[take(concat('amba-Assignment-NotificationAssets', variables('deploymentSuffix')), 64)]",
      "DataMonitorSqlDeploymentName": "[take(concat('amba-Assignment-Sql', variables('deploymentSuffix')), 64)]",
      "DataMonitorOssDBDeploymentName": "[take(concat('amba-Assignment-OssDB', variables('deploymentSuffix')), 64)]",
      "pidCuaDeploymentName": "[take(concat('amba-pid-', variables('cuaid'), '-' , uniqueString(deployment().location, parameters('enterpriseScaleCompanyPrefix'), parameters('currentDateTimeUtcNow'))), 64)]",
      "pidCuaNotificationAssetsDeploymentName": "[take(concat('amba-pid-Notification-', variables('cuaidNotificationAssets'), '-' , uniqueString(deployment().location, parameters('enterpriseScaleCompanyPrefix'), parameters('currentDateTimeUtcNow'))), 64)]",
      "pidCuaSqlDeploymentName": "[take(concat('amba-pid-Sql-', variables('cuaidSql'), '-' , uniqueString(deployment().location, parameters('enterpriseScaleCompanyPrefix'), parameters('currentDateTimeUtcNow'))), 64)]",
      "pidCuaOssDbDeploymentName": "[take(concat('amba-pid-OssDB-', variables('cuaidOssDB'), '-' , uniqueString(deployment().location, parameters('enterpriseScaleCompanyPrefix'), parameters('currentDateTimeUtcNow'))), 64)]",
      "pidCuaAmbaDataAcceleratorDeploymentName": "[take(concat('amba-pid-', variables('cuaidAmbaDataAccelerator'), '-' , uniqueString(deployment().location, parameters('enterpriseScaleCompanyPrefix'), parameters('currentDateTimeUtcNow'))), 64)]"
    }
  },
  "resources": [
    // MARK: Deploy RG

    // MARK: Deploy Policies
    // SQL Policy Definitions
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "[variables('deploymentNames').policyDefinitionsSqlDeploymentName]",
      "location": "[deployment().location]",
      "scope": "[concat('Microsoft.Management/managementGroups/', parameters('enterpriseScaleCompanyPrefix'))]",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "contentVersion": "1.0.0.0",
          "uri": "[variables('deploymentUris').policyDefinitionsSql]"
        },
        "parameters": {
          "topLevelManagementGroupPrefix": {
            "value": "[parameters('enterpriseScaleCompanyPrefix')]"
          }
        }
      }
    },
    // Oss DB Policy Definitions
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "[variables('deploymentNames').policyDefinitionsOssDBDeploymentName]",
      "location": "[deployment().location]",
      "scope": "[concat('Microsoft.Management/managementGroups/', parameters('enterpriseScaleCompanyPrefix'))]",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "contentVersion": "1.0.0.0",
          "uri": "[variables('deploymentUris').policyDefinitionsOssDB]"
        },
        "parameters": {
          "topLevelManagementGroupPrefix": {
            "value": "[parameters('enterpriseScaleCompanyPrefix')]"
          }
        }
      }
    },
    // Notification-Assets Policy Definitions
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "[variables('deploymentNames').policyDefinitionsNotificationAssetsDeploymentName]",
      "location": "[deployment().location]",
      "scope": "[concat('Microsoft.Management/managementGroups/', parameters('enterpriseScaleCompanyPrefix'))]",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "contentVersion": "1.0.0.0",
          "uri": "[variables('deploymentUris').policyDefinitionsNotificationAssets]"
        },
        "parameters": {
          "topLevelManagementGroupPrefix": {
            "value": "[parameters('enterpriseScaleCompanyPrefix')]"
          }
        }
      }
    },
    // Policy Set Definitions
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "[variables('deploymentNames').policySetDefinitionsDeploymentName]",
      "location": "[deployment().location]",
      "scope": "[concat('Microsoft.Management/managementGroups/', parameters('enterpriseScaleCompanyPrefix'))]",
      "dependsOn": [
        "[variables('deploymentNames').policyDefinitionsNotificationAssetsDeploymentName]",
        "[variables('deploymentNames').policyDefinitionsSqlDeploymentName]",
        "[variables('deploymentNames').policyDefinitionsOssDBDeploymentName]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "contentVersion": "1.0.0.0",
          "uri": "[variables('deploymentUris').policySetDefinitions]"
        },
        "parameters": {
          "topLevelManagementGroupPrefix": {
            "value": "[parameters('enterpriseScaleCompanyPrefix')]"
          }
        }
      }
    },
    // MARK: Assign Policies
    // Assigning AMBA Notification Assets PolicySet to the pseudo root management group if condition is true
    {
      "condition": "[equals(parameters('enableAMBANotificationAssets'), 'Yes')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "[variables('deploymentNames').AMBANotificationAssetsDeploymentName]",
      "scope": "[concat('Microsoft.Management/managementGroups/', parameters('enterpriseScaleCompanyPrefix'))]",
      "dependsOn": [
        "[variables('deploymentNames').policySetDefinitionsDeploymentName]"
      ],
      "location": "[deployment().location]",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "contentVersion": "1.0.0.0",
          "uri": "[variables('deploymentUris').AMBANotificationAssetsInitiative]"
        },
        "parameters": {
          "topLevelManagementGroupPrefix": {
            "value": "[parameters('enterpriseScaleCompanyPrefix')]"
          },
          "policyAssignmentParameters": {
            "value": "[variables('policyAssignmentParametersNotificationAssets')]"
          },
          "policyAssignmentExclusions": {
            "value": "[parameters('policyAssignmentExclusionList').notificationAssetsAssignmentExcludedResources.value]"
          }
        }
      }
    },
    // Assigning AMBA SQL PolicySet to the LandingZone management group if condition is true
    {
      "condition": "[equals(parameters('enableAMBASQL'), 'Yes')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "[variables('deploymentNames').AMBASQLDeploymentNameLandingZones]",
      "scope": "[concat('Microsoft.Management/managementGroups/', parameters('landingZoneManagementGroup'))]",
      "location": "[deployment().location]",
      "dependsOn": [
        "[variables('deploymentNames').policySetDefinitionsDeploymentName]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "contentVersion": "1.0.0.0",
          "uri": "[variables('deploymentUris').AMBASqlInitiative]"
        },
        "parameters": {
          "topLevelManagementGroupPrefix": {
            "value": "[parameters('enterpriseScaleCompanyPrefix')]"
          },
          "scope": {
            "value": "[parameters('landingZoneManagementGroup')]"
          },
          "policyAssignmentParameters": {
            "value": "[variables('policyAssignmentParametersSql')]"
          },
          "policyAssignmentExclusions": {
            "value": "[parameters('policyAssignmentExclusionList').sqlAssignmentLandingZonesExcludedResources.value]"
          }
        }
      }
    },
    // Assigning AMBA OSS DB PolicySet to the LandingZone management group if condition is true
    {
      "condition": "[equals(parameters('enableAMBAOSSDB'), 'Yes')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "[variables('deploymentNames').AMBAOSSDBDeploymentNameLandingZones]",
      "scope": "[concat('Microsoft.Management/managementGroups/', parameters('landingZoneManagementGroup'))]",
      "location": "[deployment().location]",
      "dependsOn": [
        "[variables('deploymentNames').policySetDefinitionsDeploymentName]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "contentVersion": "1.0.0.0",
          "uri": "[variables('deploymentUris').AMBAOSSDBInitiative]"
        },
        "parameters": {
          "topLevelManagementGroupPrefix": {
            "value": "[parameters('enterpriseScaleCompanyPrefix')]"
          },
          "scope": {
            "value": "[parameters('landingZoneManagementGroup')]"
          },
          "policyAssignmentParameters": {
            "value": "[variables('policyAssignmentParametersOSSDB')]"
          },
          "policyAssignmentExclusions": {
            "value": "[parameters('policyAssignmentExclusionList').ossDBAssignmentLandingZonesExcludedResources.value]"
          }
        }
      }
    },
    // MARK: Deploy telemetry
    // Deploying general telemetry if not opted out and not deploying from ALZ Portal Accelerator
    {
      "condition": "[equals(parameters('telemetryOptOut'), 'No')]",
      "apiVersion": "2020-06-01",
      "name": "[if(equals(parameters('deployAmbaDataPortalAccelerator'), 'No'),variables('deploymentNames').pidCuaDeploymentName, variables('deploymentNames').pidCuaAmbaDataAcceleratorDeploymentName)]",
      "location": "[deployment().location]",
      "type": "Microsoft.Resources/deployments",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    },
    // Deploying notification assets PolicySet telemetry if not opted out
    {
      "condition": "[and(equals(parameters('telemetryOptOut'), 'No'), equals(parameters('enableAMBANotificationAssets'), 'Yes'))]",
      "apiVersion": "2020-06-01",
      "name": "[variables('deploymentNames').pidCuaNotificationAssetsDeploymentName]",
      "location": "[deployment().location]",
      "type": "Microsoft.Resources/deployments",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    },
    // Deploying SQL PolicySet telemetry if not opted out
    {
      "condition": "[and(equals(parameters('telemetryOptOut'), 'No'), equals(parameters('enableAMBASql'), 'Yes'))]",
      "apiVersion": "2020-06-01",
      "name": "[variables('deploymentNames').pidCuaSqlDeploymentName]",
      "location": "[deployment().location]",
      "type": "Microsoft.Resources/deployments",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    },
    // Deploying OSS DB PolicySet telemetry if not opted out
    {
      "condition": "[and(equals(parameters('telemetryOptOut'), 'No'), equals(parameters('enableAMBAOSSDB'), 'Yes'))]",
      "apiVersion": "2020-06-01",
      "name": "[variables('deploymentNames').pidCuaOSSDBDeploymentName]",
      "location": "[deployment().location]",
      "type": "Microsoft.Resources/deployments",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    }
  ],
  "outputs": {
    "deployment": {
      "type": "string",
      "value": "[concat(deployment().name, ' has successfully deployed.')]"
    }
  }
}
